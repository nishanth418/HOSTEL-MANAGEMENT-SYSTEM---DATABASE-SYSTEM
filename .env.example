# Backend Server Environment Variables
PORT=5000
NODE_ENV=development

# Database Configuration (Aiven Cloud MySQL)
# You can provide either the full Aiven Service URI:
DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@mysql-5c45aac-YOUR_PROJECT.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED

# OR provide discrete connection parameters:
DB_HOST=mysql-5c45aac-YOUR_PROJECT.aivencloud.com
DB_PORT=YOUR_PORT
DB_USER=avnadmin
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=defaultdb
DB_SSL=true

# Frontend API Target
# Local: http://localhost:5000
# Production (Render): https://hostel-management-system-database-system.onrender.com
VITE_API_URL=https://hostel-management-system-database-system.onrender.com

